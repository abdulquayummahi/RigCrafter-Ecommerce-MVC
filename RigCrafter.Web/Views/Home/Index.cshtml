@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-5 rounded-3 bg-dark text-white shadow">
    <div class="container-fluid py-5 text-center">
        <h1 class="display-3 fw-bold">Build Your Dream Rig</h1>
        <p class="col-md-8 mx-auto fs-4 mt-3 text-light">
            Welcome to RigCrafter. We stock the highest tier processors, graphics cards, and motherboards for enthusiasts who demand absolute performance.
        </p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg mt-4 fw-bold px-5 py-3">
            Shop the Catalog 🚀
        </a>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body py-5">
                <h1 class="display-4 text-primary mb-3">⚡</h1>
                <h4 class="fw-bold">Next-Gen Performance</h4>
                <p class="text-muted">Stocking the latest architecture from AMD, Intel, and NVIDIA to push your framerates to the absolute limit.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body py-5">
                <h1 class="display-4 text-success mb-3">🛡️</h1>
                <h4 class="fw-bold">Secure Checkout</h4>
                <p class="text-muted">A fully integrated, encrypted session-based cart system ensuring your orders are processed safely and efficiently.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body py-5">
                <h1 class="display-4 text-danger mb-3">📦</h1>
                <h4 class="fw-bold">Real-Time Tracking</h4>
                <p class="text-muted">Create an account to track your order history and monitor your shipping status from processing to delivery.</p>
            </div>
        </div>
    </div>
</div>